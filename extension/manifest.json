{
  "manifest_version": 3,
  "name": "Bogestv0 VPN",
  "version": "1.2.0",
  "description": "VPN по ссылке vless:// (Reality, XTLS Vision) через локальный xray-core.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["proxy", "storage", "nativeMessaging", "tabs"],
  "host_permissions": ["https://notify.bogestv0.ru/*", "https://api.ipify.org/*", "https://api6.ipify.org/*", "https://api.github.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Bogestv0 VPN",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/off16.png", "32": "icons/off32.png" }
  },
  "icons": { "16": "icons/off16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
